# Football Agent public client flags. Do not put real secrets in Expo public env.
EXPO_PUBLIC_ANALYTICS_ENABLED=false
EXPO_PUBLIC_ADS_ENABLED=false
EXPO_PUBLIC_LIVEOPS_ENABLED=false
EXPO_PUBLIC_LIVEOPS_URL=

# Backend-only placeholders. Keep real values outside the repo and outside the web bundle.
OPENAI_API_KEY=replace-on-backend-only
STORE_SHARED_SECRET=replace-on-backend-only
GOOGLE_SERVICE_ACCOUNT_JSON=replace-on-backend-only
APPLE_SIGN_IN_KEY_ID=replace-on-backend-only
